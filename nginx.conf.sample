server {
    listen       80;
    listen       443 ssl;

    ssl_certificate your-ssl-certificate.crt;
    ssl_certificate_key your-ssl-key.key;
    ssl_protocols       TLSv1 TLSv1.1 TLSv1.2;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    
    server_name your-server-name;
    
    if ($scheme = http) {
        return 301 https://$server_name$request_uri;
    }
    
    error_log /your/nginx/logpath/$server_name.error.log;
    
   
    gzip on;
    gzip_disable "msie6";

    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_min_length 0;
    gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/vnd.ms-fontobject application/x-font-ttf font/opentype;
       
       
    location /static {
        proxy_pass http://localhost:YOUR_REACT_APP_PORT;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /sockjs-node {
            proxy_pass http://localhost:YOUR_REACT_APP_PORT;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
    }

    location /api/ {
 
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-NginX-Proxy true;
            proxy_set_header X-Forwarded-Proto http;
        
            proxy_cache_bypass $http_upgrade;
            
            proxy_cookie_domain amfdev.co.uk localhost;
            proxy_cookie_domain scbm.amfdev.co.uk localhost;

            proxy_pass_header Set-Cookie;
            
            proxy_pass http://localhost:YOUR_API_PORT/;
    }

    location / {
        
        proxy_pass http://localhost:YOUR_REACT_APP_PORT;
    }

}