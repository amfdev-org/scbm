Executing (default): INSERT INTO `messages` (`id`,`recipientProfileUrl`,`recipient`,`message`,`senderProfileUrl`,`sender`,`messageResult`,`scMessageTime`,`uniqueIndex`,`createdAt`,`updatedAt`) VALUES (NULL,'https://soundcloud.com/fogcapture','fogcapture','You too mate','https://soundcloud.com/cloaked-music','Cloaked','Success','2020-07-27T21:03:23.000Z','fogcapture^https://soundcloud.com/fogcapture^2020-07-27T21:03:23.000Z','2020-07-28 08:58:27','2020-07-28 08:58:27'),(NULL,'https://soundcloud.com/fogcapture','fogcapture','Hi Fog Capture, Good to see you!','https://soundcloud.com/user-217139012','phattunes1983','Success','2020-07-25T16:01:16.000Z','fogcapture^https://soundcloud.com/fogcapture^2020-07-25T16:01:16.000Z','2020-07-28 08:58:27','2020-07-28 08:58:27'),(NULL,'https://soundcloud.com/fogcapture','fogcapture','Hallo Fog Capture, are you interested in FREE promotion on our plattform FUTUREFY. ? I found your track right now: https://soundcloud.com/fogcapture/eastern-gulf We can repost your track and also submit it to our 24k Youtube Channel and Homepage with download gate gathering new followers for you. We do special videos with own brand as you can see here: www.youtube.com/watch?v=OzmU41Rc1Sc And also put it on our Playlists on Spotify. Futurefy is Record label and Promotion network for already Famous and New Artists and Producers, we added 250+ signed promotions via our site in less then a year. including the Artists socials and connections for sure. We scout out everyday and looking for the ones who might be intrested in a FREE promotion, nearly mostly under House/EDM/Ambient/Electronic/Future/Pop/Deep Genres. Check our work: https://futurefy.net https://www.youtube.com/futurefy https://soundcloud.com/futurefy/tracks Please let me know. Would be cool to start something. Kind regards, Horvath futurefydemos@gmail.com','https://soundcloud.com/futurefy-demo','Futurefy. Demo only','Success','2020-03-20T16:43:59.000Z','fogcapture^https://soundcloud.com/fogcapture^2020-03-20T16:43:59.000Z','2020-07-28 08:58:27','2020-07-28 08:58:27'),(NULL,'https://soundcloud.com/fogcapture','fogcapture','https://soundcloud.com/fogcapture/eastern-gulf/s-k5H9j','https://soundcloud.com/user-221609609','Simple Simon','Success','2020-02-18T20:40:37.000Z','fogcapture^https://soundcloud.com/fogcapture^2020-02-18T20:40:37.000Z','2020-07-28 08:58:27','2020-07-28 08:58:27'),(NULL,'https://soundcloud.com/fogcapture','fogcapture','Hi there, we\'re always happy if artist/label let us promote his track, but we working with signed sheets either for promo or release, this promotion sheet is only rights from artist to use it at our sites youtube/spotify/soundcloud, it must be sure we dont get problems with any label. would you mind sign this contract ? so we move on, please give me your email address i send the sheet for you to overview. you can send more music for promo, even for release as you wish! we check and back to you, you can send demos to futurefydemos@gmail.com sorry for delayed reply !','https://soundcloud.com/futurefy','Futurefy.','Success','2020-01-31T12:42:52.000Z','fogcapture^https://soundcloud.com/fogcapture^2020-01-31T12:42:52.000Z','2020-07-28 08:58:27','2020-07-28 08:58:27') ON DUPLICATE KEY UPDATE `updatedAt`=VALUES(`updatedAt`);
